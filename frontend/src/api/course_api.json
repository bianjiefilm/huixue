    "errorResponse": [
      {"status": 401, "description": "未授权 (用户未登录或无权限)"},
      {"status": 500, "description": "服务器内部错误"}
    ]
  },
  {
    "path": "/api/classrooms/{classroomId}/courses",
    "method": "POST",
    "description": "将微型实验添加到课堂",
    "request": {
      "pathParams": [
        {"name": "classroomId", "type": "string", "required": true, "description": "目标课堂ID"}
