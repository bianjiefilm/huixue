        "required": ["microCourseId"]
      }
    },
    "successResponse": {
      "status": 200,
      "body": {
        "type": "object",
        "properties": {
          "message": {"type": "string", "example": "课程添加成功"}
        }
      }
    },
    "errorResponse": [
      {"status": 400, "description": "请求参数错误"},
      {"status": 401, "description": "未授权"},
      {"status": 403, "description": "无权限操作该课堂"},
      {"status": 404, "description": "课堂或实践未找到"},
      {"status": 500, "description": "服务器内部错误"}
    ]
