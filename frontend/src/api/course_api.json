  {
    "path": "/api/classrooms",
    "method": "POST",
    "description": "创建课堂 (从课程详情页发起)",
    "request": {
      "body": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "课堂名称"},
          "credit": {"type": "number", "description": "学分"},
          "startTime": {"type": "string", "format": "date-time", "description": "开始时间"},
          "endTime": {"type": "string", "format": "date-time", "description": "结束时间"},
          "modules": {"type": "array", "items": {"type": "string"}, "description": "选用的模块 (practice, resource, exam)"},
          "courseId": {"type": "string", "description": "关联的课程资源ID"}
        },
        "required": ["name", "credit", "startTime", "endTime", "modules", "courseId"]
      }
    },
    "successResponse": {
      "status": 200,
      "body": {"$ref": "#/components/schemas/Classroom"}
    },
    "errorResponse": [
      {"status": 400, "description": "请求参数错误"},
      {"status": 401, "description": "未授权 (用户未登录或无权限)"},
      {"status": 500, "description": "服务器内部错误"}
    ]
  },
  {
    "path": "/api/classrooms/my",
