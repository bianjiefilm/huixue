[
  {
    "path": "/api/courses/resources",
    "method": "GET",
    "description": "获取课程教材列表",
    "request": {
      "queryParams": [
        {"name": "keyword", "type": "string", "required": false, "description": "搜索关键词 (课程标题、教师、学校、描述)"},
        {"name": "tags", "type": "string[]", "required": false, "description": "筛选标签名称数组"}
      ]
    },
    "successResponse": {
      "status": 200,
      "body": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "example": "1"},
            "title": {"type": "string", "example": "大数据技术基础与应用实践"},
            "cover": {"type": "string", "example": "https://picsum.photos/id/231/800/450"},
            "teacher": {"type": "string", "example": "林子雨"},
            "university": {"type": "string", "example": "厦门大学"},
            "description": {"type": "string", "example": "全面讲解大数据技术和应用..."},
            "tags": {"type": "array", "items": {"type": "string"}, "example": ["大数据", "计算机基础"]},
            "views": {"type": "number", "example": 3562},
            "rating": {"type": "number", "example": 4.8},
            "students": {"type": "number", "example": 1280},
            "chapters": {"type": "number", "example": 14},
            "practices": {"type": "number", "example": 36}
          }
        }
      }
    },
    "errorResponse": [
      {"status": 500, "description": "服务器内部错误"}
    ]
  },
