  {
    "path": "/api/challenges/evaluate",
    "method": "POST",
    "description": "评测单条测试用例",
    "request": {
      "body": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "description": "用户提交的代码"},
          "testCase": {"$ref": "#/components/schemas/TestCase"}
        },
        "required": ["code", "testCase"]
      }
    },
    "successResponse": {
      "status": 200,
      "body": {
        "type": "object",
        "properties": {
          "passed": {"type": "boolean", "example": true},
          "actualOutput": {"type": "string", "example": "我是小明，来自中国\n中国"},
          "error": {"type": "string", "required": false, "example": "编译错误: 缺少分号"}
        }
      }
    },
    "errorResponse": [
      {"status": 400, "description": "请求参数错误"},
      {"status": 500, "description": "评测服务错误"}
    ]
  },
  {
    "path": "/api/challenges/evaluate-all",
    "method": "POST",
    "description": "使用所有测试用例评测代码",
    "request": {
      "body": {
        "type": "object",
        "properties": {
          "code": {"type": "string", "description": "用户提交的代码"},
          "testCases": {"type": "array", "items": {"$ref": "#/components/schemas/TestCase"}}
        },
        "required": ["code", "testCases"]
      }
    },
    "successResponse": {
      "status": 200,
      "body": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "example": "1"},
            "title": {"type": "string", "example": "测试用例1"},
            "passed": {"type": "boolean", "example": true},
            "actualOutput": {"type": "string", "example": "我是小明，来自中国\n中国"},
            "expectedOutput": {"type": "string", "example": "我是小明，来自中国\n中国"},
            "error": {"type": "string", "required": false},
            "hidden": {"type": "boolean", "example": false}
          }
        }
      }
    },
    "errorResponse": [
      {"status": 400, "description": "请求参数错误"},
      {"status": 500, "description": "评测服务错误"}
    ]
  },
