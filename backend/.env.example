# Application Settings
APP_NAME="Huixue Education Platform"
VERSION="1.0.0"
DEBUG=False

# Security Settings - MUST CHANGE IN PRODUCTION
SECRET_KEY="CHANGE_THIS_TO_A_RANDOM_SECRET_KEY"  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings - Add your frontend domains
BACKEND_CORS_ORIGINS="http://localhost:3100,https://yourdomain.com"

# Database Settings
DATABASE_URL="sqlite:///./huixue_local.db"  # For production, use PostgreSQL: postgresql://user:pass@localhost/dbname
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis Settings (Optional - for caching)
# REDIS_URL="redis://localhost:6379/0"

# API Settings
API_V1_STR="/api/v1"

# File Upload Settings
UPLOAD_MAX_SIZE=10485760  # 10MB in bytes
ALLOWED_UPLOAD_EXTENSIONS=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip,.rar,.txt,.png,.jpg,.jpeg"

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
# ==================== AI 功能 ====================
# AI 功能总开关(默认关闭)。打开: 设为 true 并重启 backend 容器
AI_FEATURES_ENABLED=false
# 火山方舟 API 密钥(必须通过环境变量注入,代码中无默认值;未配置时 AI 调用报"AI 服务未配置")
ARK_API_KEY=
