# 慧学高校大数据平台环境配置示例
# 复制此文件为 .env 并填入实际配置值

# 应用基础配置
APP_NAME=慧学高校大数据平台
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# 数据库配置
DATABASE_URL=sqlite:///./huixue_test.db

# CORS 配置
BACKEND_CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://127.0.0.1:3100,http://127.0.0.1:3101

# 资源目录配置
HUIXUE_RESOURCE_DIR=/Users/jimfu/Desktop/huixue/backend/ziyuan

# AgentPilot SDK 配置
# 请在 PromptPilot 控制台获取以下配置信息
AGENTPILOT_API_URL=https://prompt-pilot.cn-beijing.volces.com
AGENTPILOT_API_KEY=f615ee84-e781-43eb-9393-d88ab1030156
AGENTPILOT_WORKSPACE_ID=ws-default
AGENTPILOT_SAMPLE_RATE=1.0

# 火山方舟 API 配置（可选，用于 AgentPilot 回流和推理）
ARK_API_KEY=请在此处填入您的火山方舟API密钥

# AI 服务配置（现有 AI 助教功能）
AI_API_KEY=请在此处填入您的AI服务密钥

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
